// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum VideoStatus {
  PUBLISHED
  PENDING
}

enum ArtworkStatus {
  PUBLISHED
  PENDING
}

model Video {
  id            String     @id @default(cuid())
  title         String
  slug          String     @unique
  youtubeUrl    String
  youtubeId     String
  description   String?
  thumbnail     String?
  isFeatured    Boolean    @default(false)
  isRecommended Boolean    @default(false)
  viewCount     Int        @default(0)
  status        VideoStatus @default(PUBLISHED)
  creatorName   String?
  publishedAt   DateTime   @default(now())
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tags          VideoTag[]
}

model Artwork {
  id          String       @id @default(cuid())
  title       String
  slug        String       @unique
  content     String?
  imageUrl    String
  isFeatured  Boolean      @default(false)
  isPublished Boolean      @default(true)
  status      ArtworkStatus @default(PUBLISHED)
  creatorName String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  tags        ArtworkTag[]
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  slug     String       @unique

  videos   VideoTag[]
  artworks ArtworkTag[]
}

model VideoTag {
  videoId String
  tagId   String

  video   Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([videoId, tagId])
}

model ArtworkTag {
  artworkId String
  tagId     String

  artwork   Artwork @relation(fields: [artworkId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([artworkId, tagId])
}